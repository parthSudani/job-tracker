generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local-first personal use. Swap provider + url to "postgresql"
  // and point url at a Postgres/Supabase connection string to migrate later —
  // no application code depends on the underlying engine.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A job platform / board / company-site the user tracks applications against.
model Platform {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  officialUrl           String?
  category              String
  description           String
  whyUseIt              String?
  recommendedFor        String? // comma-separated tags, e.g. "Node.js,Remote,Startups"
  recommendedFrequency  String  @default("Weekly")
  priority              String  @default("Medium") // Critical | High | Medium | Low
  priorityReason        String?
  active                Boolean  @default(true)
  isCustom              Boolean  @default(false) // user-added (e.g. individual company site)
  sortOrder             Int      @default(0)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  records ApplicationRecord[]

  @@index([category])
  @@index([priority])
  @@index([active])
}

/// One day's application count for one platform. Unique per (platform, date)
/// so re-saving the same day updates in place instead of duplicating.
model ApplicationRecord {
  id               String   @id @default(cuid())
  platformId       String
  platform         Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  date             DateTime // stored as UTC midnight for the calendar day
  applicationCount Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([platformId, date])
  @@index([date])
}

/// One optional freeform note per calendar day (separate from per-platform
/// notes on ApplicationRecord), e.g. "Focused on senior Node.js roles."
model DayNote {
  id        String   @id @default(cuid())
  date      DateTime @unique
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Singleton settings row (id is always 1).
model Settings {
  id                    Int      @id @default(1)
  dailyTarget           Int      @default(50)
  monthlyTarget         Int      @default(1000)
  timezone              String   @default("Asia/Kolkata")
  dateFormat            String   @default("dd MMM yyyy")
  theme                 String   @default("system")
  defaultDashboardRange String   @default("7d")
  updatedAt             DateTime @updatedAt
}
